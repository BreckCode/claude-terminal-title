#!/usr/bin/env bash
# ctt - Claude Terminal Title
# Sets the terminal title. Auto-detects VS Code (extension API) vs normal terminal (escape sequences).
#
# Usage:
#   ctt "Task Name: Planning"
#   ctt "Auth Fix: (3/10)"
#   ctt --status          # Check if extension server is running
#   ctt --help            # Show help

set -euo pipefail

VERSION="1.0.0"
PORT="${CTT_PORT:-7890}"
HOST="127.0.0.1"

# --- Help ---
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || -z "${1:-}" ]]; then
  cat <<EOF
ctt v${VERSION} - Claude Terminal Title

Usage:
  ctt <title>        Set the terminal title
  ctt --status       Check if the VS Code extension server is running
  ctt --help         Show this help message

Examples:
  ctt "Auth Fix: Planning"
  ctt "Auth Fix: (3/10)"
  ctt "Auth Fix: Done"

Environment:
  CTT_PORT           Override the server port (default: 7890)

In VS Code/Cursor/VSCodium: Uses the extension's HTTP server to rename the terminal tab.
In other terminals: Uses ANSI escape sequences via the parent TTY.
EOF
  exit 0
fi

# --- Status check ---
if [[ "${1:-}" == "--status" ]]; then
  if curl -sf "http://${HOST}:${PORT}/health" >/dev/null 2>&1; then
    echo "ctt: Extension server is running on port ${PORT}"
    exit 0
  else
    echo "ctt: Extension server is NOT running on port ${PORT}"
    exit 1
  fi
fi

TITLE="$1"

# --- Detect environment and set title ---

is_vscode_terminal() {
  [[ -n "${TERM_PROGRAM:-}" && "${TERM_PROGRAM}" == "vscode" ]] ||
    [[ -n "${VSCODE_PID:-}" ]] ||
    [[ -n "${VSCODE_CWD:-}" ]] ||
    [[ -n "${CURSOR_TRACE_ID:-}" ]] ||
    [[ "${TERM_PROGRAM:-}" == "cursor" ]]
}

set_title_via_extension() {
  local response
  response=$(curl -sf -X POST "http://${HOST}:${PORT}/title" \
    -H "Content-Type: application/json" \
    -d "{\"title\": \"${TITLE}\"}" 2>/dev/null) || return 1
  return 0
}

set_title_via_escape() {
  # Try to find the parent TTY and write escape sequence
  local tty_device=""

  # Method 1: Check if /dev/tty is available
  if [[ -w /dev/tty ]] 2>/dev/null; then
    tty_device="/dev/tty"
  fi

  # Method 2: Find parent process TTY
  if [[ -z "$tty_device" ]]; then
    local ppid_tty
    ppid_tty=$(ps -o tty= -p "$PPID" 2>/dev/null | tr -d ' ') || true
    if [[ -n "$ppid_tty" && "$ppid_tty" != "??" ]]; then
      if [[ -e "/dev/$ppid_tty" ]]; then
        tty_device="/dev/$ppid_tty"
      elif [[ -e "/dev/tty$ppid_tty" ]]; then
        tty_device="/dev/tty$ppid_tty"
      fi
    fi
  fi

  # Method 3: Walk up the process tree to find a TTY
  if [[ -z "$tty_device" ]]; then
    local current_pid="$$"
    for _ in 1 2 3 4 5; do
      current_pid=$(ps -o ppid= -p "$current_pid" 2>/dev/null | tr -d ' ') || break
      [[ -z "$current_pid" || "$current_pid" == "0" || "$current_pid" == "1" ]] && break
      local ancestor_tty
      ancestor_tty=$(ps -o tty= -p "$current_pid" 2>/dev/null | tr -d ' ') || continue
      if [[ -n "$ancestor_tty" && "$ancestor_tty" != "??" ]]; then
        if [[ -e "/dev/$ancestor_tty" ]]; then
          tty_device="/dev/$ancestor_tty"
          break
        elif [[ -e "/dev/tty$ancestor_tty" ]]; then
          tty_device="/dev/tty$ancestor_tty"
          break
        fi
      fi
    done
  fi

  if [[ -n "$tty_device" ]]; then
    printf '\033]0;%s\007' "$TITLE" >"$tty_device" 2>/dev/null
    return 0
  fi

  # Method 4: macOS - use osascript for Terminal.app
  if [[ "$(uname)" == "Darwin" ]]; then
    local term_app="${TERM_PROGRAM:-Terminal}"
    if [[ "$term_app" == "Apple_Terminal" || "$term_app" == "Terminal" ]]; then
      osascript -e "tell application \"Terminal\" to set custom title of front window to \"$TITLE\"" 2>/dev/null && return 0
    elif [[ "$term_app" == "iTerm.app" || "$term_app" == "iTerm2" ]]; then
      # iTerm2 proprietary escape sequence
      printf '\033]1337;SetTitle=%s\007' "$TITLE" 2>/dev/null
      return 0
    fi
  fi

  # Last resort: just print to stdout (will show in captured output but won't set title)
  printf '\033]0;%s\007' "$TITLE" 2>/dev/null
  return 0
}

# --- Main logic ---

if is_vscode_terminal; then
  # Try extension first, fall back to escape sequence
  if ! set_title_via_extension; then
    set_title_via_escape
  fi
else
  # Normal terminal: use escape sequences
  # But also try extension in case it's running (user might have VS Code open)
  if ! set_title_via_extension 2>/dev/null; then
    set_title_via_escape
  fi
fi
